def quicksort(arr):

    if(len(arr)<=1):
        return arr

    pivot=arr[0]

    left=[]
    right=[]

    for i in range(1,len(arr)):

        if(arr[i]<pivot):
            left.append(arr[i])
        else:
            right.append(arr[i])

    return quicksort(left)+[pivot]+quicksort(right)


arr=[5,1,7,2,8,3,4,9,6]

arr=quicksort(arr)

print(arr)
