def merging(A,B):
    merge=[0]*(len(A)+len(B))
    #print merge
    i,j,k=0,0,0
    while(i<len(A) and j<len(B)):
        if(A[i]<B[j]):
            merge[k]=A[i]
            i=i+1
            k=k+1
            
        else:
            merge[k]=B[j]
            j=j+1
            k=k+1
    while(i<len(A)):
        merge[k]=A[i]
        i=i+1
        k=k+1
    while(j<len(B)):
        merge[k]=B[j]
        j=j+1
        k=k+1
    return merge

A=[1,3,5,7,9,11,13,19]
B=[2,4,8,12,16,24,28]
print(merging(A,B))
